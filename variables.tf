variable "vpc_id" {
  type        = string
  description = "VPC ID"
}

variable "firewall_fail_open" {
  type        = string
  description = <<-EOF
    Determines how Route 53 Resolver handles queries during failures, for example when all traffic that is sent to DNS Firewall fails to receive a reply.
    By default, fail open is disabled, which means the failure mode is closed.
    This approach favors security over availability. DNS Firewall blocks queries that it is unable to evaluate properly.
    If you enable this option, the failure mode is open. This approach favors availability over security.
    In this case, DNS Firewall allows queries to proceed if it is unable to properly evaluate them.
    Valid values: ENABLED, DISABLED.
  EOF
  default     = "ENABLED"
}

variable "query_log_enabled" {
  type        = bool
  description = "Flag to enable/disable Route 53 Resolver query logging"
  default     = false
}

variable "query_log_destination_arn" {
  type        = string
  description = <<-EOF
    The ARN of the resource that you want Route 53 Resolver to send query logs.
    You can send query logs to an S3 bucket, a CloudWatch Logs log group, or a Kinesis Data Firehose delivery stream.
  EOF
  default     = null
}

variable "query_log_config_name" {
  type        = string
  description = "Route 53 Resolver query log config name. If omitted, the name will be generated by concatenating the ID from the context with the VPC ID"
  default     = null
}

# https://registry.terraform.io/providers/hashicorp/aws/latest/docs/resources/route53_resolver_firewall_domain_list
variable "domains_config" {
  type = map(object({
    domains      = optional(list(string))
    domains_file = optional(string)
  }))
  description = "Map of Route 53 Resolver DNS Firewall domain configurations"
}

# https://registry.terraform.io/providers/hashicorp/aws/latest/docs/resources/route53_resolver_firewall_rule_group
variable "rule_groups_config" {
  type = map(object({
    priority            = number
    mutation_protection = optional(string)
    # https://registry.terraform.io/providers/hashicorp/aws/latest/docs/resources/route53_resolver_firewall_rule
    rules = map(object({
      action                    = string
      priority                  = number
      block_override_dns_type   = optional(string)
      block_override_domain     = optional(string)
      block_override_ttl        = optional(number)
      block_response            = optional(string)
      firewall_domain_list_name = optional(string)
      firewall_domain_list_id   = optional(string)
      # INSPECT_REDIRECTION_DOMAIN (AWS default) or TRUST_REDIRECTION_DOMAIN
      firewall_domain_redirection_action = optional(string)
      # DNS Firewall Advanced rules: DGA, DICTIONARY_DGA or DNS_TUNNELING, with LOW, MEDIUM or HIGH confidence
      dns_threat_protection = optional(string)
      confidence_threshold  = optional(string)
    }))
  }))
  description = <<-EOF
    Rule groups and rules configuration.
    Each rule must specify exactly one of:
    - `firewall_domain_list_name` for custom lists defined in `domains_config` (created by this module)
    - `firewall_domain_list_id` for AWS Managed Domain Lists or other pre-existing domain lists referenced by ID
    - `dns_threat_protection` together with `confidence_threshold` for a DNS Firewall Advanced rule
      (`dns_threat_protection`: `DGA`, `DICTIONARY_DGA` or `DNS_TUNNELING`; `confidence_threshold`: `LOW`, `MEDIUM` or `HIGH`).
      DNS Firewall Advanced rules take no domain list, and `ALLOW` is not a valid action for them.
    Optionally set `firewall_domain_redirection_action` to control how the rule evaluates a CNAME/DNAME chain:
    `INSPECT_REDIRECTION_DOMAIN` (AWS default) inspects every domain in the chain;
    `TRUST_REDIRECTION_DOMAIN` inspects only the first domain.
  EOF

  validation {
    condition = alltrue(flatten([
      for rule_group in var.rule_groups_config : [
        for rule in rule_group.rules :
        rule.firewall_domain_redirection_action == null ? true : contains(["INSPECT_REDIRECTION_DOMAIN", "TRUST_REDIRECTION_DOMAIN"], rule.firewall_domain_redirection_action)
      ]
    ]))
    error_message = "`firewall_domain_redirection_action` must be `INSPECT_REDIRECTION_DOMAIN` or `TRUST_REDIRECTION_DOMAIN`."
  }

  validation {
    condition = alltrue(flatten([
      for rule_group in var.rule_groups_config : [
        for rule in rule_group.rules :
        (rule.dns_threat_protection == null ? true : contains(["DGA", "DICTIONARY_DGA", "DNS_TUNNELING"], rule.dns_threat_protection)) &&
        (rule.confidence_threshold == null ? true : contains(["LOW", "MEDIUM", "HIGH"], rule.confidence_threshold)) &&
        ((rule.dns_threat_protection == null) == (rule.confidence_threshold == null))
      ]
    ]))
    error_message = "DNS Firewall Advanced rules must set both `dns_threat_protection` (`DGA`, `DICTIONARY_DGA` or `DNS_TUNNELING`) and `confidence_threshold` (`LOW`, `MEDIUM` or `HIGH`)."
  }

  validation {
    condition = alltrue(flatten([
      for rule_group in var.rule_groups_config : [
        for rule in rule_group.rules :
        rule.dns_threat_protection == null || (rule.firewall_domain_list_name == null && rule.firewall_domain_list_id == null)
      ]
    ]))
    error_message = "A rule with `dns_threat_protection` cannot also set `firewall_domain_list_name` or `firewall_domain_list_id`."
  }
}
